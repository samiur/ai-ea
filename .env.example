# Application Settings
APP_NAME="AI Executive Assistant"
VERSION="0.1.0"
ENVIRONMENT="development"  # development, staging, production
DEBUG=true

# Database
DATABASE_URL="postgresql://assistant:assistant@localhost:5432/ai_assistant"

# Redis
REDIS_URL="redis://localhost:6379/0"

# Security
SECRET_KEY="your-secret-key-here-change-in-production"

# Google OAuth (Optional - configure when setting up Google integration)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:8000/oauth/google/callback"

# Slack (Optional - configure when setting up Slack integration)
SLACK_BOT_TOKEN=""
SLACK_SIGNING_SECRET=""
SLACK_APP_ID=""
SLACK_TEAM_ID=""

# OpenAI (for LLM processing)
OPENAI_API_KEY=""

# Feature Flags
AUTO_RESCHEDULE_ONE_ON_ONE=false
SOFT_HOLDS_ENABLED=false
SLACK_INTEGRATION_ENABLED=false
GMAIL_INTEGRATION_ENABLED=false
TRAVEL_MODE_ENABLED=false
SANITY_SWEEPS_ENABLED=false
